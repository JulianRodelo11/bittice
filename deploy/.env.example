# Image to run (GHCR tags published on each v* release)
# See: https://github.com/<owner>/bittice/pkgs/container/bittice
BITTICE_IMAGE=ghcr.io/julianrodelo11/bittice:v0.1.57

# Host ports
BITTICE_REST_PORT=3000
BITTICE_GRPC_PORT=50051

# Bind address inside the container
BITTICE_HOST=0.0.0.0

# Optional: limit CDC autostart to one entity
# BITTICE_ENTITY=my_entity

# Disable CDC autostart (static data under /app/data only, no MySQL at startup)
# BITTICE_DISABLE_CDC_AUTOSTART=1

# Directory for .ovpn files when using VPN compose (see deploy/docker-compose.vpn.yaml)
# BITTICE_VPN_DIR=/app/vpn
# BITTICE_VPN_SPLIT_TUNNEL=true
