# Image to run (GHCR tags published on each v* release)
# See: https://github.com/<owner>/bittice/pkgs/container/bittice
BITTICE_IMAGE=ghcr.io/julianrodelo11/bittice:v0.1.57

# Host ports (container always listens on 3000 = saved queries, 8080 = admin /_config, etc.)
BITTICE_REST_PORT=3000
BITTICE_REST_ADMIN_PORT=8080
BITTICE_GRPC_PORT=50051

# Bind address inside the container
BITTICE_HOST=0.0.0.0

# Server / EC2: reject setup/cdc/test CLI inside container; compose examples set BITTICE_ENGINE_ONLY=1.
# BITTICE_ENGINE_ONLY=1

# Optional: limit CDC autostart to one entity
# BITTICE_ENTITY=my_entity

# Disable CDC autostart (static data under /app/data only, no MySQL at startup)
# BITTICE_DISABLE_CDC_AUTOSTART=1

# CDC mirror durability: strict (safest/slowest) | balanced (default) | throughput / fast
# Optional fine-tuning:
# BITTICE_CDC_MIRROR_FLUSH_EVERY_N=32
# BITTICE_CDC_WAL_FSYNC_EACH_OP=1

# Directory for .ovpn files when using VPN compose (see deploy/docker-compose.vpn.yaml)
# BITTICE_VPN_DIR=/app/vpn
# BITTICE_VPN_SPLIT_TUNNEL=true

# Optional: poll GitHub releases/latest and log a WARN if tag is semver-newer than this binary.
# Does not pull or restart the container; use Watchtower for that (deploy/actualizacion-automatica-ec2.md).
# BITTICE_RELEASE_CHECK_INTERVAL_SECS=3600
# BITTICE_RELEASE_GITHUB_REPO=JulianRodelo11/bittice
