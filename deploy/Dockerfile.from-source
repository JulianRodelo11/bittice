# Multi-stage build: compile Bittice inside the image (no Rust toolchain on the host).
# Build context: bittice repository root (where Cargo.toml lives).
#
#   docker build -f deploy/Dockerfile.from-source -t bittice:local .

# syntax=docker/dockerfile:1
FROM rust:1-bookworm AS builder
WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml build.rs ./
COPY src ./src
COPY proto ./proto
# If you version Cargo.lock in the repo, add `COPY Cargo.lock ./` and use `cargo build --locked`
RUN cargo build --release

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libc6 \
    openvpn \
    iproute2 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /build/target/release/bittice /usr/local/bin/bittice
RUN chmod +x /usr/local/bin/bittice

EXPOSE 3000 8080 50051

ENTRYPOINT ["bittice"]
